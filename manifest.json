{
  "manifest_version": 3,
  "name": "FlowGraph Extension",
  "description": "Visual node-based workflow builder for Google Flow",
  "version": "0.1.0",
  "permissions": [
    "identity",
    "identity.email",
    "storage",
    "sidePanel",
    "scripting",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "http://127.0.0.1:3091/*"
  ],
  "action": {
    "default_title": "Open FlowGraph"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["studio.html", "sidepanel.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["studio.html", "sidepanel.html", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://labs.google/fx/*", "https://labs.google/fx/vi/*", "https://labs.google/fx/en/*"],
      "js": ["content/flow-content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
