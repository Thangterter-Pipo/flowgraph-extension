# MCP server exposing E:\Flow_veo over the network (Python FastMCP)

# --- Required ---
# Strong random key: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`
FLOW_VEO_MCP_API_KEY=change-me-to-a-long-random-string

# --- Optional ---
# Root directory exposed. Only paths under this are readable/writable.
FLOW_VEO_MCP_ROOT=E:\Flow_veo
# Bind address. 127.0.0.1 is correct: the Cloudflare tunnel forwards to
# 127.0.0.1:3080 on this machine, so loopback is enough and keeps the server
# off the public interface (avoids the Windows asyncio "WinError 64" hang
# caused by scanners probing an open socket).
FLOW_VEO_MCP_HOST=127.0.0.1
FLOW_VEO_MCP_PORT=3080

# --- Timeouts / limits ---
# Default command timeout (seconds). exec_command accepts timeout=0 to mean
# NO LIMIT. 0 here = no limit for tools that use the env default.
COMMAND_TIMEOUT_SECONDS=0
# Max output returned per command, MB (truncated beyond this).
MAX_COMMAND_OUTPUT_MB=50
# Max individual file read size, MB.
MAX_FILE_READ_MB=100
# Uvicorn HTTP keep-alive (seconds). 20s beats proxy/Cloudflare idle timeouts,
# so idle connections are recycled cleanly instead of being reset abruptly
# (which floods the asyncio proactor with WinError 10054 and can wedge the
# server during CPU-heavy builds). Tool-call handling itself is unbounded.
UVICORN_KEEP_ALIVE=20

# --- OAuth consent (ChatGPT connector) ---
# Owner types this PIN once on https://flowveo.thangterter.online/consent
# when adding/re-authorizing the ChatGPT MCP connector. Leave empty = OAuth deny.
FLOW_VEO_MCP_CONSENT_PIN=change-me-pin
# Extra redirect prefixes (comma-separated). Default already includes
# https://chatgpt.com/connector/oauth/ and chat.openai.com equivalent.
# FLOW_VEO_MCP_OAUTH_REDIRECT_PREFIXES=
# FLOW_VEO_MCP_ALLOW_LOCAL_OAUTH=0

# --- Git tools confinement ---
FLOW_VEO_MCP_GIT_PROJECT=E:\Flow_veo
FLOW_VEO_MCP_GIT_SCOPE=E:\Flow_veo
