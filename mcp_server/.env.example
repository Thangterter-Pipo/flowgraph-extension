# MCP server exposing E:\Flow_veo over the network (Python FastMCP)

# --- Required ---
# Strong random key: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`
FLOW_VEO_MCP_API_KEY=change-me-to-a-long-random-string

# --- Optional ---
# Root directory exposed. Only paths under this are readable/writable.
FLOW_VEO_MCP_ROOT=E:\Flow_veo
# Bind address. 0.0.0.0 is required for the Cloudflare tunnel to reach it.
FLOW_VEO_MCP_HOST=0.0.0.0
FLOW_VEO_MCP_PORT=3080

# --- Timeouts / limits ---
# Default command timeout (seconds). exec_command accepts timeout=0 to mean
# NO LIMIT. 0 here = no limit for tools that use the env default.
COMMAND_TIMEOUT_SECONDS=0
# Max output returned per command, MB (truncated beyond this).
MAX_COMMAND_OUTPUT_MB=50
# Max individual file read size, MB.
MAX_FILE_READ_MB=100
# Uvicorn HTTP keep-alive (seconds). High so long tool calls aren't cut off.
UVICORN_KEEP_ALIVE=120

# --- Git tools confinement ---
FLOW_VEO_MCP_GIT_PROJECT=E:\Flow_veo
FLOW_VEO_MCP_GIT_SCOPE=E:\Flow_veo
