# MCP server exposing E:\Flow_veo over the network (Python FastMCP)

# --- Required ---
# Strong random key: generate with `python -c "import secrets; print(secrets.token_urlsafe(32))"`
FLOW_VEO_MCP_API_KEY=change-me-to-a-long-random-string

# --- Optional ---
# Root directory exposed. Only paths under this are readable/writable.
FLOW_VEO_MCP_ROOT=E:\Flow_veo
# Bind address. 0.0.0.0 is required for the Cloudflare tunnel to reach it.
FLOW_VEO_MCP_HOST=0.0.0.0
FLOW_VEO_MCP_PORT=3080
