# Virtual envs
.venv/
venv/
__pycache__/
*.pyc

# Node / build artifacts (regenerated by npm install && npm run build)
node_modules/
dist/
.vite/
*.tsbuildinfo

# Browser profiles (huge, machine-specific, may contain personal data)
chrome-profile*/
_ctl/profile/

# Scratch & temp dirs
.stitch-test/
.tmp-v4/
flowgraph-extension/vite.log

# Evidence media (large MP4/JSONL — versioned separately)
evidence/*.mp4
evidence/*.jsonl

# Secrets
.env
*.local.env

# OS / editor
Thumbs.db
.DS_Store

# MCP server runtime
mcp_server/oauth_clients.json
mcp_server/inbox/

research/vendor/

# Operator diagnostic scripts & artifacts
_ctl/
chatgpt*
*.log
*.png
*.webp
*.mp4
*.bak

# Root one-off operator scripts (anchored to repo root only)
/*.py
/*.js
/*.txt
/*.json
/*.ts
!/package.json
!/package-lock.json
!/tsconfig*.json
!/vite.config.ts
!/vitest.config.ts
!/evidence_manifest.json
!/batch_a_t2i_60_matrix_evidence.json
!/t2i_pure_ui_click_matrix_results.json

# Extension test & sketch artifacts
flowgraph-extension/sketches/
flowgraph-extension/tests/*.py
flowgraph-extension/tests/__pycache__/
docs/context_snapshots/

# Chỉ theo dõi extension chuẩn và tài liệu/CI ở root; giữ đồ local ngoài Git.
/*
!/.gitignore
!/.github/
!/flowgraph-extension/
!/docs/
!/README.md
!/CHANGELOG.md
!/CONTRIBUTING.md
